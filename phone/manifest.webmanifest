{
  "name": "TrackMyShows",
  "short_name": "Shows",
  "description": "Where you're at in every show, synced with your Kodi boxes.",
  "start_url": "./#/watching",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b1120",
  "theme_color": "#0f172a",
  "shortcuts": [
    { "name": "Up next (cover)", "short_name": "Up next", "url": "./#/cover", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "TV remote", "short_name": "Remote", "url": "./#/remote", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Discover", "url": "./#/search", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Movies", "url": "./#/movies", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
